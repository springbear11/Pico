#include <winver.h>
1 VERSIONINFO
 FILEVERSION @COMPONENT_VERSION_NUMBERS@
 PRODUCTVERSION @COMPONENT_VERSION_NUMBERS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @COMPONENT_FILETYPE@
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "@COMPONENT_FILENAME@\0"
   VALUE "FileVersion", "@COMPONENT_VERSION@\0"
   VALUE "ProductName", "PicoATE\0"
   VALUE "ProductVersion", "@COMPONENT_VERSION@\0"
   VALUE "OriginalFilename", "@COMPONENT_FILENAME@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
