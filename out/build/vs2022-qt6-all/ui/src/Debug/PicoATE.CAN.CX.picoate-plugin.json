{
  "schema": "picoate.plugin",
  "schemaVersion": 1,
  "pluginId": "picoate.can.cx",
  "moduleId": "plugin.can.cx",
  "name": "CX USB-CAN",
  "category": "CAN",
  "version": "1.0.0",
  "functions": [
    {
      "id": "open",
      "name": "Open CAN",
      "description": "Open and initialize a CX ControlCAN channel",
      "stepKind": "action",
      "timeoutMs": 5000,
      "inputs": [
        {
          "key": "deviceType",
          "name": "Device Type",
          "type": "enum",
          "default": 4,
          "options": [
            {"label": "Auto", "value": 0},
            {"label": "USBCAN-I", "value": 3},
            {"label": "USBCAN-II / CANalyst-II", "value": 4}
          ]
        },
        {"key": "deviceIndex", "name": "Device Index", "type": "integer", "default": 0, "minimum": 0},
        {"key": "channelIndex", "name": "Channel", "type": "integer", "default": 0, "minimum": 0, "maximum": 1},
        {
          "key": "bitrate",
          "name": "Bitrate",
          "type": "enum",
          "default": 500000,
          "options": [
            {"label": "125 kbit/s", "value": 125000},
            {"label": "250 kbit/s", "value": 250000},
            {"label": "500 kbit/s", "value": 500000},
            {"label": "1 Mbit/s", "value": 1000000}
          ]
        },
        {"key": "listenOnly", "name": "Listen Only", "type": "boolean", "default": false},
        {"key": "selfTest", "name": "Self Test", "type": "boolean", "default": false}
      ],
      "outputs": [
        {"key": "connected", "name": "Connected", "type": "boolean"},
        {"key": "device", "name": "Device", "type": "string"}
      ]
    },
    {
      "id": "write",
      "name": "Send CAN Frame",
      "description": "Transmit one classic CAN frame",
      "stepKind": "action",
      "timeoutMs": 2000,
      "inputs": [
        {"key": "id", "name": "CAN ID (Std 0x000-0x7FF / Ext 0x00000000-0x1FFFFFFF)", "type": "string", "required": true, "default": "0x123"},
        {"key": "data", "name": "Frame Data", "type": "hex-bytes", "required": true, "default": "01 02 03 04"},
        {"key": "extended", "name": "Extended Frame", "type": "boolean", "default": false},
        {"key": "remote", "name": "Remote Frame", "type": "boolean", "default": false}
      ],
      "outputs": [
        {"key": "transmitted", "name": "Transmitted", "type": "boolean"}
      ]
    },
    {
      "id": "read",
      "name": "Read CAN Frame",
      "description": "Receive one CAN frame with an optional ID filter",
      "stepKind": "action",
      "timeoutMs": 2500,
      "inputs": [
        {"key": "filterId", "name": "Filter ID (0x00000000-0x1FFFFFFF)", "type": "string", "default": "0x000"},
        {"key": "filterMask", "name": "Filter Mask (0=Any, Std Exact=0x7FF, Ext Exact=0x1FFFFFFF)", "type": "string", "default": "0x000"},
        {"key": "timeoutMs", "name": "Receive Timeout", "type": "integer", "default": 1500, "minimum": 0, "maximum": 60000, "unit": "ms"}
      ],
      "outputs": [
        {"key": "id", "name": "CAN ID", "type": "string"},
        {"key": "idNumeric", "name": "CAN ID Numeric", "type": "integer"},
        {"key": "dataHex", "name": "Frame Data", "type": "hex-bytes"},
        {"key": "dlc", "name": "Data Length", "type": "integer", "unit": "byte"}
      ]
    },
    {
      "id": "close",
      "name": "Close CAN",
      "description": "Close the active CX CAN channel",
      "stepKind": "cleanup",
      "timeoutMs": 3000,
      "outputs": [
        {"key": "connected", "name": "Connected", "type": "boolean"}
      ]
    }
  ]
}
