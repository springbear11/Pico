{
  "schema": "picoate.plugin",
  "schemaVersion": 1,
  "pluginId": "picoate.can.gcan",
  "moduleId": "plugin.can.gcan",
  "name": "GCAN USB-CAN",
  "category": "CAN",
  "vendor": "Guangcheng Technology",
  "version": "1.0.0",
  "functions": [
    {
      "id": "open",
      "name": "Open CAN",
      "description": "Open a GCAN device channel",
      "stepKind": "action",
      "timeoutMs": 5000,
      "inputs": [
        {"key": "deviceType", "name": "Device Type", "type": "integer", "default": 0, "minimum": 0},
        {"key": "deviceIndex", "name": "Device Index", "type": "integer", "default": 0, "minimum": 0},
        {"key": "channelIndex", "name": "Channel", "type": "integer", "default": 0, "minimum": 0},
        {
          "key": "bitrate",
          "name": "Bitrate",
          "type": "enum",
          "default": 500000,
          "options": [
            {"label": "125 kbit/s", "value": 125000},
            {"label": "250 kbit/s", "value": 250000},
            {"label": "500 kbit/s", "value": 500000},
            {"label": "1 Mbit/s", "value": 1000000}
          ]
        },
        {"key": "canFd", "name": "CAN FD", "type": "boolean", "default": false},
        {"key": "selfTest", "name": "Self Test", "type": "boolean", "default": false}
      ],
      "outputs": [
        {"key": "opened", "name": "Opened", "type": "boolean"}
      ],
      "stepTemplate": {
        "errorPolicy": {
          "onFail": "RunCleanup",
          "onError": "RunCleanup",
          "onTimeout": "RunCleanup"
        }
      }
    },
    {
      "id": "write",
      "name": "Send CAN Frame",
      "description": "Transmit one CAN data frame",
      "stepKind": "action",
      "timeoutMs": 2000,
      "inputs": [
        {"key": "id", "name": "CAN ID (Std 0x000-0x7FF / Ext 0x00000000-0x1FFFFFFF)", "type": "string", "required": true, "default": "0x123"},
        {"key": "data", "name": "Frame Data", "type": "hex-bytes", "required": true, "default": "01 02 03 04"}
      ],
      "outputs": [
        {"key": "sent", "name": "Sent Frames", "type": "integer", "unit": "frame"}
      ]
    },
    {
      "id": "read",
      "name": "Read CAN Frame",
      "description": "Receive one CAN frame with an optional ID filter",
      "stepKind": "action",
      "timeoutMs": 2500,
      "inputs": [
        {"key": "filterId", "name": "Filter ID (0x00000000-0x1FFFFFFF)", "type": "string", "default": "0x000"},
        {"key": "filterMask", "name": "Filter Mask (0=Any, Std Exact=0x7FF, Ext Exact=0x1FFFFFFF)", "type": "string", "default": "0x000"},
        {"key": "timeoutMs", "name": "Receive Timeout", "type": "integer", "default": 1500, "minimum": 0, "maximum": 60000, "unit": "ms"}
      ],
      "outputs": [
        {"key": "id", "name": "CAN ID", "type": "string"},
        {"key": "data", "name": "Frame Data", "type": "hex-bytes"},
        {"key": "dlc", "name": "Data Length", "type": "integer", "unit": "byte"}
      ]
    },
    {
      "id": "close",
      "name": "Close CAN",
      "description": "Close the active GCAN device channel",
      "stepKind": "cleanup",
      "timeoutMs": 3000,
      "outputs": [
        {"key": "closed", "name": "Closed", "type": "boolean"}
      ]
    }
  ]
}
