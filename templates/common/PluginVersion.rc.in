#include <winver.h>
1 VERSIONINFO
 FILEVERSION @PLUGIN_VERSION_NUMBERS@
 PRODUCTVERSION @PLUGIN_VERSION_NUMBERS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "@PLUGIN_FILENAME@\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductName", "PicoATE Plugin\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "OriginalFilename", "@PLUGIN_FILENAME@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
