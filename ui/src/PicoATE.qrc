        <file alias="circle.svg">assets/lucide/circle.svg</file>
        <file alias="circle-check.svg">assets/lucide/circle-check.svg</file>
        <file alias="circle-x.svg">assets/lucide/circle-x.svg</file>
        <file alias="arrow-up.svg">assets/lucide/arrow-up.svg</file>
